%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Microsoft YaHei, SimSun, Arial", "fontSize": "18px", "primaryColor": "#EAF2FF", "primaryBorderColor": "#2F5E9E", "lineColor": "#555555", "actorBkg": "#EAF2FF", "actorBorder": "#2F5E9E"}}}%%
sequenceDiagram
  autonumber
  participant U as 用户
  participant FE as 前端界面
  participant RT as SessionRuntime
  participant WS as realtime_ws
  participant M as 实时模型/回退链路
  participant DB as 数据库

  U->>FE: 点击开始通话
  FE->>RT: 启动 integrated-realtime
  RT->>WS: 建立 WebSocket(session_id)
  WS-->>RT: session.ready

  loop 持续语音交互
    FE->>RT: audio chunk
    RT->>WS: audio.chunk
    WS->>M: 转发音频流
    M-->>WS: 转写 / 文本 / 音频事件
    WS-->>RT: transcript / text.delta / audio.delta
    RT-->>FE: 更新字幕、消息与播放状态
  end

  alt 用户插话
    U->>FE: 打断播报
    FE->>RT: interrupt
    RT->>WS: interrupt event
    WS-->>RT: assistant.interrupted
    RT-->>FE: 标记当前回复被打断
  else 正常结束
    WS->>DB: 写入 messages 与 session_chain_audits
    WS->>DB: 更新 session_memories
    WS-->>RT: metrics.turn / session.updated
    RT-->>FE: 展示最终消息与指标
  end
