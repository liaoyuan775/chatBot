POSTGRES_USER=chatbot_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=chatbot_dev
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=8080

APP_NAME=Chinese Voice Chat Backend
APP_ENV=production
APP_ENCRYPTION_KEY=replace_with_a_long_random_secret
ALLOWED_DATABASES=chatbot_dev,chatbot_prod
SESSION_TTL_SECONDS=3600
MEMORY_WINDOW_TURNS=6
SIMULATION_ENABLED=false

VITE_API_BASE_URL=

VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_TEXT_MODEL=doubao-seed-1-6-251015

DASHSCOPE_API_KEY=
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang

SILICONFLOW_API_KEY=
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
