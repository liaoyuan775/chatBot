# Docker compose env template
# Copy to `.env.docker` and fill in real secrets before first start.
# This version reuses an existing PostgreSQL/pgvector instance.

DATABASE_URL=postgresql+asyncpg://chatbot_app:change_me_strong_password@127.0.0.1:5432/chatbot_dev
ALLOWED_DATABASES=chatbot_dev,chatbot_prod

BACKEND_PORT=8000
FRONTEND_PORT=8080

APP_NAME=Chinese Voice Chat Backend
APP_ENV=production
APP_ENCRYPTION_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_SESSION_TTL_HOURS=12
AUTH_COOKIE_NAME=chatbot_admin_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_REQUESTS=120
DIAGNOSTICS_RECENT_ERROR_LIMIT=20
SESSION_TTL_SECONDS=3600
MEMORY_WINDOW_TURNS=6
SIMULATION_ENABLED=false

# Replace with your actual HTTPS domain(s) in production.
CORS_ORIGINS=["https://yuanjmsh.xyz","https://www.yuanjmsh.xyz"]

# Leave blank to use same-origin proxy in the frontend container.
VITE_API_BASE_URL=

VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_TEXT_MODEL=doubao-seed-1-6-251015

DASHSCOPE_API_KEY=
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang

SILICONFLOW_API_KEY=
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
